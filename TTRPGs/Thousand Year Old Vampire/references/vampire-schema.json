{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thousand Year Old Vampire — Vampire State",
  "description": "Schema for per-vampire game state files. All per-vampire data lives in ~/Documents/Vault/Public/TTRPGs/Thousand Year Old Vampire/Vampires/{VampireName}.json",
  "type": "object",
  "required": [
    "name",
    "game_start",
    "current_prompt",
    "prompts_resolved",
    "game_over",
    "memories",
    "skills",
    "resources",
    "characters"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Vampire name"
    },
    "vampire_desc": {
      "type": "string",
      "description": "Vampire description/concept"
    },
    "mortal_self": {
      "type": "string",
      "description": "The mortal life summary"
    },
    "game_start": {
      "type": "string",
      "format": "date",
      "description": "ISO date when the game started"
    },
    "modified": {
      "type": "string",
      "format": "date",
      "description": "ISO date of last modification"
    },
    "game_over": {
      "type": "boolean",
      "description": "Whether the game has ended"
    },
    "game_completed": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "ISO date when the game completed, or null if still playing"
    },
    "current_prompt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 80,
      "description": "Current prompt number (0 = not yet rolled, 1-80 = active)"
    },
    "prompts_resolved": {
      "type": "integer",
      "minimum": 0,
      "maximum": 80,
      "description": "Number of prompts resolved"
    },
    "memories": {
      "type": "array",
      "maxItems": 5,
      "description": "Active memories. Maximum 5 at any time. Each holds up to 3 experience summaries.",
      "items": {
        "type": "object",
        "required": [
          "n",
          "theme",
          "experiences"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "Slot number 1-5. Recycled when a memory is lost."
          },
          "theme": {
            "type": "string",
            "description": "The name or header of this memory."
          },
          "description": {
            "type": "string",
            "description": "Optional extended description."
          },
          "experiences": {
            "type": "array",
            "maxItems": 3,
            "description": "Experience summaries added when resolving journal entries. When a 3rd experience would become a 4th, the memory is lost.",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "lost_memories": {
      "type": "array",
      "description": "Memories that were lost when a 4th experience was added. Ordered by lost_at ascending.",
      "items": {
        "type": "object",
        "required": [
          "n",
          "theme",
          "experiences",
          "lost_at",
          "lost_on_turn"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "description": "The slot number this memory occupied when lost."
          },
          "theme": {
            "type": "string",
            "description": "The theme of the lost memory."
          },
          "experiences": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "description": "All 3 experiences at the time of loss.",
            "items": {
              "type": "string"
            }
          },
          "lost_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp of when this memory was lost."
          },
          "lost_on_turn": {
            "type": "integer",
            "description": "The journal turn number that caused this memory to be lost."
          }
        },
        "additionalProperties": false
      }
    },
    "diary": {
      "type": "object",
      "properties": {
        "memories": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "spent",
              "struck"
            ]
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "portable",
              "stationary",
              "diary"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "struck"
            ]
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "mortal",
              "immortal"
            ]
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "alive",
              "dead"
            ]
          },
          "death_reason": {
            "type": "string"
          }
        }
      }
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "concealment": {
            "type": "string"
          }
        }
      }
    },
    "journal": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "turn",
          "prompt",
          "entry",
          "resolved"
        ],
        "properties": {
          "turn": {
            "type": "integer"
          },
          "prompt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 80
          },
          "entry": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "resolved": {
            "type": "boolean"
          },
          "experience": {
            "type": "string"
          },
          "changes": {
            "type": "string"
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "ISO 8601 timestamp of when this entry was resolved. Null if still awaiting."
          }
        }
      }
    },
    "epitaph": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "experience": {
          "type": "string"
        }
      }
    }
  }
}